{
	"name": "pi-roost",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Agent view for pi: one screen for every background pi session — dispatch, peek, reply, attach, detach",
	"keywords": [
		"pi-package",
		"pi",
		"agents",
		"background",
		"agent-view"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luoxin9510/pi-roost.git"
	},
	"engines": {
		"node": ">=20"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"prepare": "npm run build",
		"install:local": "sh scripts/install-local.sh"
	},
	"dependencies": {
		"@xterm/headless": "^6.0.0",
		"node-pty": "^1.1.0"
	},
	"bin": {
		"pi-roost": "dist/bin/pi-roost.js"
	},
	"files": [
		"extensions",
		"lib",
		"dist",
		"README.md"
	],
	"exports": {
		"./api": {
			"types": "./dist/lib/api.d.ts",
			"default": "./dist/lib/api.js"
		},
		"./package.json": "./package.json"
	}
}
